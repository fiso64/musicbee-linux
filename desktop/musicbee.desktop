[Desktop Entry]
Type=Application
Name=MusicBee
GenericName=Music Player
Comment=MusicBee Music Player via Wine
Exec=musicbee-manage desktop-setup %f
Terminal=true
Icon=multimedia-audio-player
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/x-mp3;audio/x-flac;audio/flac;audio/x-wav;audio/wav;audio/aac;audio/mp4;audio/x-m4a;audio/ogg;audio/x-vorbis+ogg;audio/x-opus+ogg;audio/x-ape;audio/x-wavpack;audio/mpegurl;audio/x-mpegurl;application/vnd.apple.mpegurl;audio/x-scpls;
StartupNotify=true
StartupWMClass=musicbee.exe
